{
  "name": "@openimport/ui",
  "version": "0.2.0",
  "description": "A beautiful, accessible, ready-made React import experience for openimport.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "import",
    "csv",
    "excel",
    "react",
    "data-import",
    "importer",
    "column-mapping",
    "oneschema",
    "flatfile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openimport/openimport.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/openimport/openimport#readme",
  "exports": {
    ".": {
      "@openimport/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@openimport/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.21",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1"
  },
  "peerDependencies": {
    "@openimport/core": "workspace:^",
    "@openimport/react": "workspace:^",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@openimport/core": "workspace:^",
    "@openimport/csv": "workspace:^",
    "@openimport/react": "workspace:^",
    "@openimport/worker": "workspace:^",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
