{
  "name": "@openimport/react",
  "version": "0.1.0",
  "description": "React hooks and context for OpenImport — build your own import UI on the headless core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "import",
    "csv",
    "react",
    "hooks",
    "headless",
    "data-import"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openimport/openimport.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/openimport/openimport#readme",
  "exports": {
    ".": {
      "@openimport/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@openimport/core": "workspace:^",
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@openimport/core": "workspace:^",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
