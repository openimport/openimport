{
  "name": "@openimport/json",
  "version": "0.2.0",
  "description": "JSON and JSON Lines format plugins for OpenImport with automatic record discovery.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "openimport",
    "import",
    "data-import",
    "json",
    "jsonl",
    "ndjson"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openimport/openimport.git",
    "directory": "packages/json"
  },
  "homepage": "https://github.com/openimport/openimport#readme",
  "bugs": "https://github.com/openimport/openimport/issues",
  "exports": {
    ".": {
      "@openimport/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@openimport/core": "workspace:^"
  },
  "devDependencies": {
    "@openimport/core": "workspace:^"
  }
}
