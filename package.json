{
  "name": "openimport-monorepo",
  "private": true,
  "description": "The open-source, headless data importer for modern applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openimport/openimport.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" -r build",
    "dev": "pnpm --filter web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:packages": "pnpm --filter \"./packages/**\" -r exec publint --pack pnpm",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "bench": "pnpm --filter @openimport/example-benchmark start --",
    "smoke": "pnpm build && pnpm --filter @openimport/example-runtime-smoke run node",
    "e2e": "pnpm --filter @openimport/e2e test",
    "e2e:perf": "PERF=1 pnpm --filter @openimport/e2e perf"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@valibot/to-json-schema": "^1.8.0",
    "arktype": "^2.2.8",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.3",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
